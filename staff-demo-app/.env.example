# Copy to .env.local — never commit secrets.
# Showcase mode (public Marshall demo): set VITE_SHOWCASE_MODE=true — no backend secrets needed.

VITE_SHOWCASE_MODE=true

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-demo-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-demo-project-default-rtdb.firebaseio.com/
VITE_FIREBASE_PROJECT_ID=your-demo-project
VITE_FIREBASE_STORAGE_BUCKET=your-demo-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

VITE_DEFAULT_TENANT_ID=showcase-venue

VITE_BOOKING_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_BOOKING_IMPORT_KEY=your-import-key-here
